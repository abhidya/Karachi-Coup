    "test:e2e:ui": "playwright test --ui",
    "test:e2e:github": "E2E_BASE_URL=https://abhidya.github.io/Karachi-Coup/ playwright test",
    "profile:e2e:github": "PROFILE_BASE_URL=https://abhidya.github.io/Karachi-Coup/ node scripts/profile-six-client-room.mjs",
    "profile:e2e": "node scripts/profile-six-client-room.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trystero": "^0.25.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
